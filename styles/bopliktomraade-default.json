{
  "version": 8,
  "name": "Bopliktområde - standard",
  "sources": {
    "bopliktomraade": {
      "type": "geojson",
      "data": "${PYGEOAPI_URL}/v1/collections/bopliktomraade/items?f=json&limit=50"
    }
  },
  "layers": [
    {
      "id": "bopliktomraade-fill",
      "type": "fill",
      "source": "bopliktomraade",
      "paint": {
        "fill-color": "#f2c14e",
        "fill-opacity": 0.35,
        "fill-outline-color": "#7a4f01"
      }
    },
    {
      "id": "bopliktomraade-outline",
      "type": "line",
      "source": "bopliktomraade",
      "paint": {
        "line-color": "#7a4f01",
        "line-width": 2
      }
    }
  ]
}